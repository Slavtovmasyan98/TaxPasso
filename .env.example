VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true — демо без базы (для превью). В продакшене — false или не указывать.
VITE_DEMO_MODE=false
# true — показать кнопку «Продолжить с Google» (только после настройки Google в Supabase)
VITE_GOOGLE_AUTH=false
# true — консультация специалиста для ответов «Не знаю» / «Нет основания» (только после миграций 016–017 в этой базе)
VITE_SPECIALIST_CONSULT=false
# true — блок доп. услуг в кабинете (только после миграции 018; клиент видит лишь услуги с active=true)
VITE_ADDONS=false
